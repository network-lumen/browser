# Copy to tests/e2e/.env, or generate one: npm run e2e:wallet
#
# Only the chain tests read this (`npm run test:e2e:chain`), and that command is
# the only thing that runs them: the project does not exist in a plain
# `playwright test`, so no ordinary run can spend. They also skip on their own
# when this file is absent, so the suite works without a wallet.
#
# tests/e2e/.env is gitignored. Never commit a mnemonic, and never put one here
# that holds anything you would mind losing: these tests broadcast real
# transactions on the real chain.

# The funded wallet. It is the source of every test transfer and the address
# leftovers are swept back to. Fund it with a small amount - a test never needs
# more than dust, and the cap below is enforced before signing.
LUMEN_E2E_MNEMONIC="twelve words that this machine generated and nobody else has ever seen"
LUMEN_E2E_ADDRESS=lmn1...

# Refuses to sign anything larger, in LMN. A test that miscomputes an amount
# should fail, not spend.
LUMEN_E2E_MAX_LMN=0.05

# Optional. Defaults to the chain the app is already configured for; set it only
# when pointing the tests somewhere else.
# LUMEN_E2E_CHAIN_ID=lumen
